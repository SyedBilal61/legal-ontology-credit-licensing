<?xml version="1.0"?>
<rdf:RDF xmlns="http://creditontology.com/section29#"
     xml:base="http://creditontology.com/section29"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ont="http://www.co-ode.org/ontologies/ont.owl#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:section29="http://creditontology.com/section29#"
     xmlns:credit-licensing-ontology="http://www.example.org/credit-licensing-ontology#">
    <owl:Ontology rdf:about="http://creditontology.com/section29#">
        <dc:creator>Syed Bilal Hassan</dc:creator>
        <dc:title>Credit Activities Licensing Ontology</dc:title>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://creditontology.com/section29#actsOnBehalfOf -->


    <owl:ObjectProperty rdf:about="http://creditontology.com/section29#actsOnBehalfOf">
        <rdfs:domain rdf:resource="http://www.co-ode.org/ontologies/ont.owl#AgentEngagingCreditActivity"/>
        <rdfs:range rdf:resource="http://www.example.org/credit-licensing-ontology#Principal"/>
        <rdfs:comment>Acting on Behalf of Principal</rdfs:comment>
        <rdfs:label>actsOnBehalfOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://creditontology.com/section29#hasDefence -->


    <owl:ObjectProperty rdf:about="http://creditontology.com/section29#hasDefence">
        <rdfs:domain rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:range rdf:resource="http://www.example.org/credit-licensing-ontology#Defence"/>
        <rdfs:comment>they Must have a defence</rdfs:comment>
        <rdfs:label>hasDefence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://creditontology.com/section29#hasEngagedIn -->


    <owl:ObjectProperty rdf:about="http://creditontology.com/section29#hasEngagedIn">
        <rdfs:domain rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:range rdf:resource="http://www.example.org/credit-licensing-ontology#CreditActivity"/>
        <rdfs:comment>Engage in a credit Activity</rdfs:comment>
        <rdfs:label>hasEngagedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://creditontology.com/section29#hasLicense -->


    <owl:ObjectProperty rdf:about="http://creditontology.com/section29#hasLicense">
        <rdfs:domain rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:range rdf:resource="http://www.example.org/credit-licensing-ontology#License"/>
        <rdfs:comment>For engaging in Credit Activity there is need of license that is required</rdfs:comment>
        <rdfs:label>hasLicense</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://creditontology.com/section29#isExemptPrincipal -->


    <owl:DatatypeProperty rdf:about="http://creditontology.com/section29#isExemptPrincipal">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isExemptPrinicipal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://creditontology.com/section29#isWithInAuthority -->


    <owl:DatatypeProperty rdf:about="http://creditontology.com/section29#isWithInAuthority">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isWithInAuthority</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#getPenalty -->


    <owl:DatatypeProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#getPenalty">
        <rdfs:domain rdf:resource="http://www.example.org/credit-licensing-ontology#Penalty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>getPanalty</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#hasDefence -->


    <owl:DatatypeProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#hasDefence">
        <rdfs:domain rdf:resource="http://www.example.org/credit-licensing-ontology#Defence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>hasDefence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#hasOffence -->


    <owl:DatatypeProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#hasOffence">
        <rdfs:domain rdf:resource="http://www.example.org/credit-licensing-ontology#Offence"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>hasOffence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#isActingOnBehalfOfPrincipal -->


    <owl:DatatypeProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#isActingOnBehalfOfPrincipal">
        <rdfs:domain rdf:resource="http://www.co-ode.org/ontologies/ont.owl#AgentEngagingCreditActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isActingOnBehalfOfPrincipal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#isPrincipalElectedInParliament -->


    <owl:DatatypeProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#isPrincipalElectedInParliament">
        <rdfs:domain rdf:resource="http://www.example.org/credit-licensing-ontology#Principal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isPrinicpalHoldingElectedParliament</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#isPrincipalHoldingCreditActivity -->


    <owl:DatatypeProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#isPrincipalHoldingCreditActivity">
        <rdfs:domain rdf:resource="http://www.example.org/credit-licensing-ontology#Principal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isPrinicpalHoldingCreditActivity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#isRepresentativeOfBodyCorporate -->


    <owl:DatatypeProperty rdf:about="http://www.co-ode.org/ontologies/ont.owl#isRepresentativeOfBodyCorporate">
        <rdfs:domain rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isRepresentativeOfBodyCorporate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/credit-licensing-ontology#isValidLicense -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/credit-licensing-ontology#isValidLicense">
        <rdfs:domain rdf:resource="http://www.example.org/credit-licensing-ontology#License"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isValidLicense</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/credit-licensing-ontology#licenseNumber -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/credit-licensing-ontology#licenseNumber">
        <rdfs:domain rdf:resource="http://www.example.org/credit-licensing-ontology#License"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>LicenceNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://creditontology.com/section29#CompliantAgent -->


    <owl:Class rdf:about="http://creditontology.com/section29#CompliantAgent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.co-ode.org/ontologies/ont.owl#PermittedAgent_R3a"/>
                    <rdf:Description rdf:about="http://www.co-ode.org/ontologies/ont.owl#PermittedAgent_R3b"/>
                    <rdf:Description rdf:about="http://www.co-ode.org/ontologies/ont.owl#PermittedAgent_R3c"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:comment>If an agent satisfies one of the permission rules, it is compliant.</rdfs:comment>
        <rdfs:label>CompliantAgent</rdfs:label>
    </owl:Class>
    


    <!-- http://creditontology.com/section29#ExemptPrincipalDefence -->


    <owl:Class rdf:about="http://creditontology.com/section29#ExemptPrincipalDefence">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://creditontology.com/section29#actsOnBehalfOf"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.example.org/credit-licensing-ontology#Principal"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://creditontology.com/section29#isExemptPrincipal"/>
                                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://creditontology.com/section29#isWithInAuthority"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>ExemptPrincipalDefence</rdfs:label>
    </owl:Class>
    


    <!-- http://creditontology.com/section29#LicensedPrincipal -->


    <owl:Class rdf:about="http://creditontology.com/section29#LicensedPrincipal">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/credit-licensing-ontology#Principal"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.example.org/credit-licensing-ontology#isValidLicense"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>LicensedPrincipal</rdfs:label>
    </owl:Class>
    


    <!-- http://creditontology.com/section29#NonCompliantAgent -->


    <owl:Class rdf:about="http://creditontology.com/section29#NonCompliantAgent">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/credit-licensing-ontology#isValidLicense"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:comment>An agent who does not satisfy any of the R3 conditions</rdfs:comment>
        <rdfs:label>NonCompliantAgent</rdfs:label>
    </owl:Class>
    


    <!-- http://creditontology.com/section29#RepresentativeDefence -->


    <owl:Class rdf:about="http://creditontology.com/section29#RepresentativeDefence">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://creditontology.com/section29#StaffOrRepresentative"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://creditontology.com/section29#actsOnBehalfOf"/>
                        <owl:someValuesFrom rdf:resource="http://creditontology.com/section29#LicensedPrincipal"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://creditontology.com/section29#isWithInAuthority"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>RepresentativeDefence</rdfs:label>
    </owl:Class>
    


    <!-- http://creditontology.com/section29#StaffOrRepresentative -->


    <owl:Class rdf:about="http://creditontology.com/section29#StaffOrRepresentative">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/credit-licensing-ontology#CreditRepresentative"/>
                    <rdf:Description rdf:about="http://www.example.org/credit-licensing-ontology#Director"/>
                    <rdf:Description rdf:about="http://www.example.org/credit-licensing-ontology#Employee"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>StaffOrRepresentative</rdfs:label>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#AgentEngagingCreditActivity -->


    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#AgentEngagingCreditActivity">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/credit-licensing-ontology#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://creditontology.com/section29#hasEngagedIn"/>
                        <owl:someValuesFrom rdf:resource="http://www.example.org/credit-licensing-ontology#CreditActivity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:comment>Any Agent who involves in a Credit Activity</rdfs:comment>
        <rdfs:label>AgentEngagingCreditActivity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#BodyCorporate -->


    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#BodyCorporate">
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Principal"/>
        <rdfs:comment>A legal entity such as a company that may act as a principal</rdfs:comment>
        <rdfs:label>BodyCorporate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#OffenceWithDefence -->


    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#OffenceWithDefence">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#hasDefence"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Offence"/>
        <rdfs:comment>An agent who committed an offence but has a valid defence</rdfs:comment>
        <rdfs:label>OffenceWithDefence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#OffenceWithPenalty -->


    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#OffenceWithPenalty">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#getPenalty"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Offence"/>
        <rdfs:comment>An agent who committed an offence and received a civil penalty</rdfs:comment>
        <rdfs:label>OffenceWithPenalty</rdfs:label>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#PermittedAgent_R3a -->


    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#PermittedAgent_R3a">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/credit-licensing-ontology#isValidLicense"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:comment>An agent who holds a valid license and performs credit activity</rdfs:comment>
        <rdfs:label>PermittedAgent_R3a</rdfs:label>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#PermittedAgent_R3b -->


    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#PermittedAgent_R3b">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#isActingOnBehalfOfPrincipal"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#isPrincipalElectedInParliament"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#isPrincipalHoldingCreditActivity"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:comment>An agent acting on behalf of a licensed principal within authorized credit activity</rdfs:comment>
        <rdfs:label>PermittedAgent_R3b</rdfs:label>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#PermittedAgent_R3c -->


    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#PermittedAgent_R3c">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#isActingOnBehalfOfPrincipal"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#isRepresentativeOfBodyCorporate"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.example.org/credit-licensing-ontology#isValidLicense"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:comment>An Agent who is acting on a behalf of a principal and or a representative of body corporate(exempted from licensing requirements)</rdfs:comment>
        <rdfs:label>PermittedAgent_R3c</rdfs:label>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Test_NonCompliant -->


    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Test_NonCompliant">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/credit-licensing-ontology#isValidLicense"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:comment>An agent who does not satisfy any of the R3 conditions</rdfs:comment>
        <rdfs:label>Test_NonCompliant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Test_Offending -->


    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Test_Offending">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#hasOffence"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Agent"/>
        <rdfs:comment>Any agent who committed an offence under Section 29</rdfs:comment>
        <rdfs:label>Test_Offending</rdfs:label>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#UnlicensedCreditOffence -->


    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#UnlicensedCreditOffence">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/credit-licensing-ontology#isValidLicense"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.example.org/credit-licensing-ontology#Offence"/>
        <rdfs:comment>An offence where an agent engaged in credit activity without holding a license</rdfs:comment>
        <rdfs:label>UnlicensedCreditOffence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/credit-licensing-ontology#Agent -->


    <owl:Class rdf:about="http://www.example.org/credit-licensing-ontology#Agent">
        <rdfs:label>Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/credit-licensing-ontology#Conduct -->


    <owl:Class rdf:about="http://www.example.org/credit-licensing-ontology#Conduct">
        <rdfs:label>Conduct</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/credit-licensing-ontology#CourtCase -->


    <owl:Class rdf:about="http://www.example.org/credit-licensing-ontology#CourtCase">
        <rdfs:label>CourtCase</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/credit-licensing-ontology#CreditActivity -->


    <owl:Class rdf:about="http://www.example.org/credit-licensing-ontology#CreditActivity">
